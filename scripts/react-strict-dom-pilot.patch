@@ -0,0 +1,35 @@
+import { css, html } from "react-strict-dom";
+
+const styles = css.create({
+  row: {
+    display: "flex",
+    flexDirection: "row",
+    alignItems: "center",
+    padding: 16,
+    gap: 8,
+  },
+  badge: {
+    backgroundColor: "#274b3b",
+    color: "#ffffff",
+    borderRadius: 999,
+    paddingInline: 10,
+    paddingBlock: 2,
+  },
+  button: {
+    backgroundColor: "#274b3b",
+    color: "#ffffff",
+    borderRadius: 8,
+    paddingInline: 12,
+    paddingBlock: 6,
+  },
+});
+
+export default function StrictDomProbe() {
+  return (
+    <html.div style={styles.row}>
+      <html.span style={styles.badge}>Badge</html.span>
+      <html.button style={styles.button} onClick={() => undefined}>Button</html.button>
+      <html.div>Item row</html.div>
+    </html.div>
+  );
+}

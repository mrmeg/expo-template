{
  "name": "template",
  "main": "expo-router/entry",
  "version": "0.0.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "bun ./server.bun.ts",
    "start-local": "bun --env-file=.env ./server.bun.ts",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:scan": "expo start --web",
    "scan:showcase": "node -e \"const { spawnSync } = require('node:child_process'); const port = process.env.EXPO_DEV_SERVER_PORT || process.env.PORT || '8081'; spawnSync('open', ['http://localhost:' + port + '/showcase?scan'], { stdio: 'inherit' });\"",
    "gen:templates": "npx tsx scripts/generate-template-registry.ts",
    "gen:templates:check": "npx tsx scripts/generate-template-registry.ts --check",
    "gen:blocks": "npx tsx scripts/generate-block-registry.ts",
    "gen:blocks:check": "npx tsx scripts/generate-block-registry.ts --check",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 expo export -p web --output-dir dist",
    "build-web": "NODE_OPTIONS=--max-old-space-size=8192 expo export -p web --output-dir dist --dump-sourcemap",
    "build-sourcemap": "bun run build-web",
    "view-sourcemap": "bun x source-map-explorer 'dist/client/_expo/static/js/web/*.js' --no-border-checks",
    "view-sourcemap:gzip": "bun x source-map-explorer 'dist/client/_expo/static/js/web/*.js' --no-border-checks --gzip",
    "analyze": "bun run build-web && bun run view-sourcemap",
    "analyze:gzip": "bun run build-web && bun run view-sourcemap:gzip",
    "serve:ssr": "expo serve",
    "bundle-size": "node scripts/check-bundle-size.js",
    "check:features": "node scripts/check-feature-isolation.js",
    "docs:llms": "node scripts/build-llms-full.mjs",
    "docs:llms:check": "node scripts/build-llms-full.mjs --check",
    "docs:versions:check": "node scripts/check-readme-versions.mjs",
    "pkg": "node scripts/run-package-script.mjs",
    "ui:typecheck": "node scripts/run-package-script.mjs ui typecheck",
    "ui:test": "node scripts/run-package-script.mjs ui test",
    "ui:build": "node scripts/run-package-script.mjs ui build",
    "ui:pack": "node scripts/run-package-script.mjs ui pack",
    "ui:consumer-smoke": "node scripts/run-package-script.mjs ui consumer-smoke",
    "ui:release": "node scripts/run-package-script.mjs ui release",
    "media:typecheck": "node scripts/run-package-script.mjs media typecheck",
    "media:test": "node scripts/run-package-script.mjs media test",
    "media:build": "node scripts/run-package-script.mjs media build",
    "media:pack": "node scripts/run-package-script.mjs media pack",
    "media:consumer-smoke": "node scripts/run-package-script.mjs media consumer-smoke",
    "media:release": "node scripts/run-package-script.mjs media release",
    "packages:peer-check": "node scripts/check-package-peer-compatibility.mjs",
    "packages:compatibility": "node scripts/check-package-consumer-profile.mjs",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --coverage --forceExit",
    "e2e": "maestro test .maestro",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "verify": "node scripts/verify.mjs",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0; lefthook install",
    "generate": "npx tsx scripts/generate.ts",
    "init": "npx tsx scripts/init.ts"
  },
  "dependencies": {
    "@aws-amplify/react-native": "^1.3.3",
    "@clerk/backend": "^3.16.13",
    "@clerk/clerk-expo": "^2.19.31",
    "@expo/metro-runtime": "~57.0.14",
    "@expo/ui": "~57.0.14",
    "@hookform/resolvers": "^5.9.1",
    "@mrmeg/expo-media": "workspace:*",
    "@mrmeg/expo-ui": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.102.8",
    "aws-amplify": "^6.20.0",
    "aws-jwt-verify": "^5.2.1",
    "expo": "~57.0.18",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-server": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.19",
    "expo-video": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "heic2any": "^0.0.4",
    "i18next": "^26.4.0",
    "intl-pluralrules": "^2.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.12",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "semver": "^7.8.5",
    "stripe": "^22.6.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/runtime": "^8.0.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@sentry/cli": "3.7.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.4.0",
    "@types/react": "~19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expo-atlas": "^0.4.3",
    "globals": "^17.11.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "lefthook": "^2.1.12",
    "pretty-format": "30.5.0",
    "react-test-renderer": "19.2.8",
    "reactotron-react-native": "^5.3.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "baseline-browser-mapping": "^2.10.27",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-primitive": "2.1.4"
  },
  "license": "MIT",
  "private": true
}

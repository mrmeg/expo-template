{
  "name": "template",
  "main": "expo-router/entry",
  "version": "0.0.1",
  "workspaces": [
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "start": "bun ./server.bun.ts",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "scan:showcase": "node -e \"const { spawnSync } = require('node:child_process'); const port = process.env.EXPO_DEV_SERVER_PORT || process.env.PORT || '8081'; spawnSync('open', ['http://localhost:' + port + '/components?scan'], { stdio: 'inherit' });\"",
    "gen": "node scripts/gen.mjs",
    "gen:templates": "bun scripts/generate-template-registry.ts",
    "gen:templates:check": "bun scripts/generate-template-registry.ts --check",
    "gen:blocks": "bun scripts/generate-block-registry.ts",
    "gen:blocks:check": "bun scripts/generate-block-registry.ts --check",
    "brand:assets": "node scripts/build-brand-assets.mjs",
    "ui:icons": "node scripts/build-icon-registry.mjs",
    "ui:icons:check": "node scripts/build-icon-registry.mjs --check",
    "icons": "node packages/ui/bin/expo-ui-icons.mjs",
    "icons:check": "node packages/ui/bin/expo-ui-icons.mjs --check",
    "icons:tabs": "node packages/ui/bin/expo-ui-icons.mjs tabs",
    "icons:tabs:check": "node packages/ui/bin/expo-ui-icons.mjs tabs --check",
    "build": "EXPO_UNSTABLE_TREE_SHAKING=1 EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=1 NODE_OPTIONS=--max-old-space-size=8192 expo export -p web --output-dir dist && node scripts/precompress.mjs dist/client",
    "build-web": "EXPO_UNSTABLE_TREE_SHAKING=1 EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=1 NODE_OPTIONS=--max-old-space-size=8192 expo export -p web --output-dir dist --dump-sourcemap && node scripts/precompress.mjs dist/client",
    "view-sourcemap": "bun x source-map-explorer 'dist/client/_expo/static/js/web/*.js' --no-border-checks",
    "view-sourcemap:gzip": "bun x source-map-explorer 'dist/client/_expo/static/js/web/*.js' --no-border-checks --gzip",
    "analyze": "bun run build-web && bun run view-sourcemap",
    "analyze:gzip": "bun run build-web && bun run view-sourcemap:gzip",
    "serve:ssr": "expo serve",
    "bundle-size": "node scripts/check-bundle-size.js",
    "check:features": "node scripts/check-feature-isolation.js",
    "docs:llms": "node scripts/build-llms-full.mjs",
    "docs:llms:check": "node scripts/build-llms-full.mjs --check",
    "docs:versions:check": "node scripts/check-readme-versions.mjs",
    "pkg": "node scripts/run-package-script.mjs",
    "ui:typecheck": "node scripts/run-package-script.mjs ui typecheck",
    "ui:test": "node scripts/run-package-script.mjs ui test",
    "ui:build": "node scripts/run-package-script.mjs ui build",
    "ui:pack": "node scripts/run-package-script.mjs ui pack",
    "ui:consumer-smoke": "node scripts/run-package-script.mjs ui consumer-smoke",
    "ui:release": "node scripts/run-package-script.mjs ui release",
    "media:typecheck": "node scripts/run-package-script.mjs media typecheck",
    "media:test": "node scripts/run-package-script.mjs media test",
    "media:build": "node scripts/run-package-script.mjs media build",
    "media:pack": "node scripts/run-package-script.mjs media pack",
    "media:consumer-smoke": "node scripts/run-package-script.mjs media consumer-smoke",
    "media:release": "node scripts/run-package-script.mjs media release",
    "media:fixtures": "node scripts/build-media-fixtures.mjs",
    "purchases:typecheck": "node scripts/run-package-script.mjs purchases typecheck",
    "purchases:test": "node scripts/run-package-script.mjs purchases test",
    "purchases:build": "node scripts/run-package-script.mjs purchases build",
    "purchases:pack": "node scripts/run-package-script.mjs purchases pack",
    "purchases:consumer-smoke": "node scripts/run-package-script.mjs purchases consumer-smoke",
    "purchases:release": "node scripts/run-package-script.mjs purchases release",
    "lint:typecheck": "node scripts/run-package-script.mjs lint typecheck",
    "lint:test": "node scripts/run-package-script.mjs lint test",
    "lint:build": "node scripts/run-package-script.mjs lint build",
    "lint:pack": "node scripts/run-package-script.mjs lint pack",
    "lint:consumer-smoke": "node scripts/run-package-script.mjs lint consumer-smoke",
    "lint:release": "node scripts/run-package-script.mjs lint release",
    "packages:peer-check": "node scripts/check-package-peer-compatibility.mjs",
    "packages:drift-check": "node scripts/check-package-publish-drift.mjs",
    "packages:compatibility": "node scripts/check-package-consumer-profile.mjs",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --forceExit",
    "test:coverage": "jest --ci --coverage --forceExit",
    "e2e": "maestro test .maestro",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "lint:ui": "node packages/lint/bin/cli.js",
    "verify": "node scripts/verify.mjs",
    "generate": "bun scripts/generate.ts",
    "init": "bun scripts/init.ts",
    "auth:emails": "bun scripts/apply-cognito-email-templates.ts"
  },
  "dependencies": {
    "@aws-amplify/react-native": "^1.3.3",
    "@aws-amplify/rtn-web-browser": "^1.4.0",
    "@clerk/backend": "^3.26.2",
    "@clerk/clerk-expo": "^2.20.1",
    "@expo-google-fonts/newsreader": "0.4.1",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/ui": "~58.0.23",
    "@fontsource-variable/newsreader": "5.3.0",
    "@hookform/resolvers": "^6.0.0",
    "@mrmeg/expo-media": "workspace:*",
    "@mrmeg/expo-ui": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react": "11.9.0",
    "@sentry/react-native": "^8.32.0",
    "@tanstack/react-query": "^5.104.5",
    "aws-amplify": "^6.22.2",
    "aws-jwt-verify": "^5.2.1",
    "expo": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-auth-session": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-server": "~58.0.6",
    "expo-splash-screen": "~58.0.11",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "expo-video": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "heic2any": "^0.0.4",
    "i18next": "^26.5.10",
    "intl-pluralrules": "^2.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.8",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~2.0.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "semver": "^7.8.5",
    "stripe": "^23.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^8.0.8",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@mrmeg/eslint-plugin-expo-ui": "workspace:*",
    "@react-native/jest-preset": "0.88.0",
    "@sentry/cli": "3.8.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "lucide-static": "1.61.0",
    "pretty-format": "30.5.1",
    "react-test-renderer": "19.3.1",
    "reactotron-react-native": "^5.3.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "baseline-browser-mapping": "^2.10.27",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-primitive": "2.1.4"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "24.22.1"
  }
}

{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "customConditions": [
      "react-native",
      "@mrmeg/source"
    ],
    "noImplicitAny": false,
    "jsx": "react-native",
    "types": [
      "react-native",
      "node",
      "jest"
    ],
    "skipLibCheck": true,
    "module": "esnext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "expo-env.d.ts",
    "workers"
  ]
}

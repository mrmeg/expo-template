{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@mrmeg/expo-ui": [
        "./packages/ui/src/index.ts"
      ],
      "@mrmeg/expo-ui/components": [
        "./packages/ui/src/components/index.ts"
      ],
      "@mrmeg/expo-ui/components/*": [
        "./packages/ui/src/components/*"
      ],
      "@mrmeg/expo-ui/constants": [
        "./packages/ui/src/constants/index.ts"
      ],
      "@mrmeg/expo-ui/hooks": [
        "./packages/ui/src/hooks/index.ts"
      ],
      "@mrmeg/expo-ui/state": [
        "./packages/ui/src/state/index.ts"
      ],
      "@mrmeg/expo-ui/state/*": [
        "./packages/ui/src/state/*"
      ],
      "@mrmeg/expo-ui/lib": [
        "./packages/ui/src/lib/index.ts"
      ],
      "@mrmeg/expo-media": [
        "./packages/media/src/index.ts"
      ],
      "@mrmeg/expo-media/client": [
        "./packages/media/src/client/index.ts"
      ],
      "@mrmeg/expo-media/react-query": [
        "./packages/media/src/react-query/index.ts"
      ],
      "@mrmeg/expo-media/processing": [
        "./packages/media/src/processing/index.ts"
      ],
      "@mrmeg/expo-media/server": [
        "./packages/media/src/server/index.ts"
      ],
      "@mrmeg/expo-media/worker": [
        "./packages/media/src/worker/index.ts"
      ],
      "@mrmeg/expo-purchases": [
        "./packages/purchases/src/index.ts"
      ],
      "@mrmeg/expo-purchases/server": [
        "./packages/purchases/src/server/index.ts"
      ]
    },
    "noImplicitAny": false,
    "jsx": "react-native",
    "types": [
      "react-native",
      "node",
      "jest"
    ],
    "skipLibCheck": true,
    "module": "esnext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    // `expo start` and `expo export` regenerate this file with a reference to
    // `expo/types`, whose react-native-web augmentation widens `ViewStyle.position`
    // with `fixed` and `sticky`. React Native 0.88 types the `View` style prop
    // through an internal alias the augmentation never reaches, so every
    // `ViewStyle` handed to a `View` fails to typecheck once the file exists.
    // Nothing here needs the file (the program is clean without it); drop this
    // entry when Expo ships an augmentation that matches RN 0.88.
    "expo-env.d.ts",
    // Deployable Cloudflare Workers are typechecked by their own standalone
    // tsconfig (workerd lib + @cloudflare/workers-types), which is incompatible
    // with this project's react-native/node type set.
    "workers",
  ]
}

EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=1
EXPO_UNSTABLE_TREE_SHAKING=1

# App identity — leave blank to keep the template defaults ("template" /
# "myapp" / "com.mrmeg.template"). When you rename for a real app, set
# all five together so app.config.ts (native build) and client/lib/identity
# (deep-link return URLs) stay in sync. Malformed values throw at config
# load — adopters see the error before the build fails.
EXPO_PUBLIC_APP_NAME=""
EXPO_PUBLIC_APP_SLUG=""
EXPO_PUBLIC_APP_SCHEME=""
EXPO_PUBLIC_APP_IOS_BUNDLE_ID=""
EXPO_PUBLIC_APP_ANDROID_PACKAGE=""

# EAS project id. Optional — leave blank to keep EAS Update off. `eas init`
# creates the project and prints the id; set it here (or as an EAS environment
# variable) to add `extra.eas.projectId`, the `updates.url`, and the fingerprint
# `runtimeVersion` to app.config.ts. While blank, cloud builds still work; only
# OTA updates are disabled.
EAS_PROJECT_ID=""

# External API origin. Optional on web — leave blank to use the local Expo Router
# `app/api/*` routes on the page origin. Set it when pointing the client at a
# separate backend (the production config falls back to a placeholder when empty).
#
# On native this is also the media client's origin, and there is no page origin to
# fall back on: media needs an absolute URL here (the `localhost:3000` default in
# client/config/config.dev.ts is not used by media). While blank, the Media tab
# fails closed — it renders its disabled state and makes no request. Accepts either
# form, e.g. `http://localhost:3000` or `http://localhost:3000/api`.
EXPO_PUBLIC_API_URL=""

# Auth. Optional — leave everything blank to keep auth disabled and explore
# the template without an identity provider. Configure exactly one provider:
#
#   Cognito: set both user-pool vars; setting just one warns at startup.
#            Email-code (passwordless) sign-in also needs the pool itself to
#            allow EMAIL_OTP as a first auth factor and the app client to allow
#            ALLOW_USER_AUTH; `bash scripts/create-cognito-pool.sh` creates a
#            pool with both. That same EMAIL_OTP setting is what lets sign-up
#            skip the password entirely (the default sign-up action): on a pool
#            without it, Cognito rejects the passwordless sign-up and the form
#            surfaces the reason, so use "Add a password" instead.
#   Clerk:   set EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY (pk_test_… / pk_live_…)
#            and CLERK_SECRET_KEY (sk_test_… / sk_live_…, server-only).
#
# If both providers are configured, Cognito wins; set EXPO_PUBLIC_AUTH_PROVIDER
# ("cognito" | "clerk") to choose explicitly.
EXPO_PUBLIC_AUTH_PROVIDER=""
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
EXPO_PUBLIC_USER_POOL_ID=""
EXPO_PUBLIC_USER_POOL_CLIENT_ID=""

# Cognito Managed Login domain, without the scheme — either the AWS-hosted
# `<prefix>.auth.<region>.amazoncognito.com` or your own custom domain. Only
# needed for social sign-in (it's the redirect host); email-code and password
# sign-in work without it. `scripts/create-cognito-pool.sh` prints the value it
# creates. Requires the pool's callback/logout URLs to list `<scheme>://` (see
# EXPO_PUBLIC_APP_SCHEME) for native and your web origins for the browser.
EXPO_PUBLIC_COGNITO_DOMAIN=""

# Social sign-in buttons to show, comma-separated: "google", "apple", or
# "google,apple". Blank hides them. Fails closed: the buttons only render when
# Cognito is the active provider AND EXPO_PUBLIC_COGNITO_DOMAIN is set AND the
# named identity providers are registered on the pool with credentials from
# Google/Apple (see scripts/create-cognito-pool.sh). On native, the redirect
# needs the autolinked `@aws-amplify/rtn-web-browser` module — that means a dev
# build, not Expo Go.
EXPO_PUBLIC_AUTH_SOCIAL_PROVIDERS=""

# Sentry. Optional — leave all values blank to keep runtime error tracking and
# native debug-symbol/source-map upload disabled. Set the DSN to enable runtime
# reporting. Set the native upload vars only in developer/CI secrets when you
# want native builds to upload debug symbols and source maps.
EXPO_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# R2/S3 Storage. Optional — leave blank to keep media disabled. With any of
# the four vars missing or whitespace-only, every /api/media/* route returns
# `503 media-disabled` and the Media tab renders a setup-state instead of
# crashing. Set all four to enable uploads, listing, signed URLs, and delete.
# With real storage configured, media routes require authenticated users by
# default. For local demos only, set EXPO_TEMPLATE_ALLOW_PUBLIC_MEDIA=true to
# allow public media access outside production; production ignores this flag.
R2_JURISDICTION_SPECIFIC_URL=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
EXPO_TEMPLATE_ALLOW_PUBLIC_MEDIA="false"

# Billing — Client (safe to ship in the JS bundle)
# Turn on the billing UI (pricing CTAs, manage-subscription button). Defaults
# to "false" so projects that don't need Stripe can ignore these vars entirely.
EXPO_PUBLIC_BILLING_ENABLED="false"
# Absolute web origin used to build Stripe Checkout / Portal success + cancel
# URLs when the request doesn't already carry one (e.g. native clients on
# cellular). Leave empty in dev to use the request origin.
EXPO_PUBLIC_APP_URL=""

# Billing — Server (NEVER expose these to client code)
# Stripe secret key (sk_test_… in test mode, sk_live_… in production).
STRIPE_SECRET_KEY=""
# Stripe webhook signing secret (whsec_…). The Stripe CLI prints one when you
# run `stripe listen --forward-to localhost:3000/api/billing/webhook`.
STRIPE_WEBHOOK_SECRET=""
# Price IDs that back the default plan catalog. Leave a value empty to disable
# that plan/interval; the server returns 422 configuration-missing when an
# unconfigured interval is requested.
STRIPE_PRICE_ID_PRO_MONTH=""
STRIPE_PRICE_ID_PRO_YEAR=""

{
  "name": "@mrmeg/expo-ui",
  "version": "0.29.2",
  "private": false,
  "description": "Reusable Expo and React Native UI primitives for MrMeg projects.",
  "keywords": [
    "expo",
    "react-native",
    "react-native-web",
    "design-system",
    "ui-primitives",
    "universal-ui"
  ],
  "author": "Matt Megenhardt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrmeg/expo-template.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/mrmeg/expo-template/issues"
  },
  "homepage": "https://github.com/mrmeg/expo-template/tree/main/packages/ui",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "expo-ui-icons": "./bin/expo-ui-icons.mjs"
  },
  "sideEffects": [
    "./src/state/themeStore.ts",
    "./dist/state/themeStore.js"
  ],
  "files": [
    "bin",
    "dist",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LLM_USAGE.md",
    "llms.txt",
    "llms-full.md"
  ],
  "exports": {
    ".": {
      "@mrmeg/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components": {
      "@mrmeg/source": "./src/components/index.ts",
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./components/bottomSheetDismiss": {
      "@mrmeg/source": "./src/components/bottomSheetDismiss.ts",
      "types": "./dist/components/bottomSheetDismiss.d.ts",
      "default": "./dist/components/bottomSheetDismiss.js"
    },
    "./components/bottomSheetHostSupport": {
      "@mrmeg/source": "./src/components/bottomSheetHostSupport.ts",
      "types": "./dist/components/bottomSheetHostSupport.d.ts",
      "default": "./dist/components/bottomSheetHostSupport.js"
    },
    "./components/iconBuiltins.generated": {
      "@mrmeg/source": "./src/components/iconBuiltins.generated.ts",
      "types": "./dist/components/iconBuiltins.generated.d.ts",
      "default": "./dist/components/iconBuiltins.generated.js"
    },
    "./components/iconTypes": {
      "@mrmeg/source": "./src/components/iconTypes.ts",
      "types": "./dist/components/iconTypes.d.ts",
      "default": "./dist/components/iconTypes.js"
    },
    "./components/index": {
      "@mrmeg/source": "./src/components/index.ts",
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./components/keyboardController": {
      "@mrmeg/source": {
        "react-native": "./src/components/keyboardController.native.ts",
        "default": "./src/components/keyboardController.ts"
      },
      "types": "./dist/components/keyboardController.d.ts",
      "default": "./dist/components/keyboardController.js"
    },
    "./components/keyboardDismiss": {
      "@mrmeg/source": "./src/components/keyboardDismiss.ts",
      "types": "./dist/components/keyboardDismiss.d.ts",
      "default": "./dist/components/keyboardDismiss.js"
    },
    "./components/keyboardFocusRegistry": {
      "@mrmeg/source": "./src/components/keyboardFocusRegistry.ts",
      "types": "./dist/components/keyboardFocusRegistry.d.ts",
      "default": "./dist/components/keyboardFocusRegistry.js"
    },
    "./components/nativeFieldLabelSupport": {
      "@mrmeg/source": "./src/components/nativeFieldLabelSupport.ts",
      "types": "./dist/components/nativeFieldLabelSupport.d.ts",
      "default": "./dist/components/nativeFieldLabelSupport.js"
    },
    "./components/StyledText.context": {
      "@mrmeg/source": "./src/components/StyledText.context.ts",
      "types": "./dist/components/StyledText.context.d.ts",
      "default": "./dist/components/StyledText.context.js"
    },
    "./components/*": {
      "@mrmeg/source": "./src/components/*.tsx",
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./constants": {
      "@mrmeg/source": "./src/constants/index.ts",
      "types": "./dist/constants/index.d.ts",
      "default": "./dist/constants/index.js"
    },
    "./constants/*": {
      "@mrmeg/source": "./src/constants/*.ts",
      "types": "./dist/constants/*.d.ts",
      "default": "./dist/constants/*.js"
    },
    "./hooks": {
      "@mrmeg/source": "./src/hooks/index.ts",
      "types": "./dist/hooks/index.d.ts",
      "default": "./dist/hooks/index.js"
    },
    "./hooks/useReduceMotion": {
      "@mrmeg/source": "./src/hooks/useReduceMotion.tsx",
      "types": "./dist/hooks/useReduceMotion.d.ts",
      "default": "./dist/hooks/useReduceMotion.js"
    },
    "./hooks/*": {
      "@mrmeg/source": "./src/hooks/*.ts",
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./state": {
      "@mrmeg/source": "./src/state/index.ts",
      "types": "./dist/state/index.d.ts",
      "default": "./dist/state/index.js"
    },
    "./state/themeColorScope": {
      "@mrmeg/source": "./src/state/themeColorScope.tsx",
      "types": "./dist/state/themeColorScope.d.ts",
      "default": "./dist/state/themeColorScope.js"
    },
    "./state/*": {
      "@mrmeg/source": "./src/state/*.ts",
      "types": "./dist/state/*.d.ts",
      "default": "./dist/state/*.js"
    },
    "./lib": {
      "@mrmeg/source": "./src/lib/index.ts",
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./design-system.json": {
      "default": "./dist/design-system.json"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config ../../jest.config.js packages/ui/src --runInBand --watchman=false && bun run check:forbidden-imports",
    "build": "node ../../scripts/build-icon-registry.mjs && rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/icons && cp src/icons/lucide.json src/icons/LICENSE.lucide dist/icons/ && node ../../scripts/fix-package-esm.mjs ui && node ../../scripts/build-design-system-manifest.mjs ui && bun run check:forbidden-imports",
    "check:forbidden-imports": "node ../../scripts/check-ui-forbidden-imports.mjs",
    "publish:dry-run": "bun pm pack --dry-run"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@rn-primitives/accordion": "~1.5.2",
    "@rn-primitives/alert-dialog": "~1.5.2",
    "@rn-primitives/checkbox": "~1.5.2",
    "@rn-primitives/collapsible": "~1.5.2",
    "@rn-primitives/dialog": "~1.5.2",
    "@rn-primitives/dropdown-menu": "~1.5.2",
    "@rn-primitives/label": "~1.5.2",
    "@rn-primitives/popover": "~1.5.2",
    "@rn-primitives/portal": "~1.5.3",
    "@rn-primitives/radio-group": "~1.5.2",
    "@rn-primitives/select": "~1.5.2",
    "@rn-primitives/separator": "~1.5.2",
    "@rn-primitives/slot": "~1.5.2",
    "@rn-primitives/switch": "~1.5.2",
    "@rn-primitives/tabs": "~1.5.2",
    "@rn-primitives/toggle": "~1.5.2",
    "@rn-primitives/toggle-group": "~1.5.2",
    "@rn-primitives/tooltip": "~1.5.2"
  },
  "peerDependencies": {
    "@expo/ui": ">=56.0.0 <59.0.0 || >=58.0.0-0 <59.0.0",
    "@react-native-async-storage/async-storage": ">=2.2.0 <2.3.0",
    "expo": ">=56.0.0 <59.0.0 || >=58.0.0-0 <59.0.0",
    "expo-font": ">=56.0.0 <59.0.0 || >=58.0.0-0 <59.0.0",
    "expo-haptics": ">=56.0.0 <59.0.0 || >=58.0.0-0 <59.0.0",
    "react": ">=19.2.0 <20.0.0",
    "react-native": ">=0.85.0 <0.89.0 || >=0.88.0-0 <0.89.0",
    "react-native-gesture-handler": ">=2.30.0 <4.0.0",
    "react-native-keyboard-controller": ">=1.21.0 <2.0.0",
    "react-native-safe-area-context": ">=5.6.0 <6.0.0",
    "react-native-screens": ">=4.23.0 <5.0.0",
    "react-native-svg": ">=15.0.0 <16.0.0",
    "react-native-web": ">=0.21.0 <0.22.0",
    "zustand": ">=5.0.0 <6.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "media",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  // Path-scoped so anything else already serving cdn.mrmeg.com keeps working.
  "routes": [
    {
      "pattern": "cdn.mrmeg.com/api/media/*",
      "zone_name": "mrmeg.com"
    }
  ],
  // Created during the deploy runbook:
  //   wrangler kv namespace create MEDIA_AUTH
  // then paste the printed id here.
  "kv_namespaces": [
    {
      "binding": "MEDIA_AUTH",
      "id": "195923b605444522b01d6ff3f8565f62"
    }
  ],
  // Non-secret R2 coordinates. R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY are
  // secrets — set them with `wrangler secret put`, never in this file.
  "vars": {
    "R2_BUCKET": "mrmeg",
    "R2_JURISDICTION_SPECIFIC_URL": "https://776658da55f21acb7c2b201bfa3096db.r2.cloudflarestorage.com"
  }
}

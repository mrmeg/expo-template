{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_UNSTABLE_TREE_SHAKING": "1",
        "EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH": "1"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_UNSTABLE_TREE_SHAKING": "1",
        "EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_UNSTABLE_TREE_SHAKING": "1",
        "EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH": "1"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_UNSTABLE_TREE_SHAKING": "1",
        "EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH": "1"
      }
    }
  }
}
